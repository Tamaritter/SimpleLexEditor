{
  "name": "simplelexeditor",
  "private": true,
  "version": "1.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/build/dev.ps1",
    "build:desktop": "powershell -ExecutionPolicy Bypass -File scripts/build/build.ps1",
    "test": "vitest run --dir tests/unit",
    "test:e2e": "npm run build && playwright test",
    "audit:rust": "node scripts/checks/audit-rust.mjs",
    "verify:release": "node scripts/release/verify-release.mjs",
    "prebuild": "node scripts/build/copy-pdf-assets.mjs",
    "notices": "node scripts/release/generate-notices.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "codemirror": "^6.0.1",
    "fflate": "^0.8.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mathlive": "0.111.4",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tauri-apps/cli": "^2.5.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^5.1.0"
  }
}
