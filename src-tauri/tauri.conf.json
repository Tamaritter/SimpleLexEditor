{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleLexEditor",
  "version": "1.6.0",
  "identifier": "de.roxena.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SimpleLexEditor",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "SimpleLexEditor",
    "targets": ["nsis"],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "shortDescription": "LaTeX-Editor mit PDF-Live-Vorschau",
    "category": "Productivity",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "minimumWebview2Version": "125.0.0.0",
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "compression": "none"
      }
    }
  }
}
